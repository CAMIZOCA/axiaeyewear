---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductImage from '../components/ProductImage.astro';
import { products, categoryUrl } from '../data/catalog';
const featured = ['solar-humo','clip-pizarra','screen-violeta','screen-coral'].map((slug) => products.find((p) => p.slug === slug)!);
const collections = [
  { slug: 'gafas-de-sol', label: 'Sunglasses', product: products[0], number: '01' },
  { slug: 'screen-glasses', label: 'Screen Glasses', product: products.find((p) => p.slug === 'screen-violeta')!, number: '02' },
  { slug: 'clips', label: 'Clips', product: products.find((p) => p.slug === 'clip-miel')!, number: '03' },
] as const;
---
<SiteLayout title="Mirar con intención" description="AXIA Eyewear: gafas de sol, monturas y clips con valor propio. Explora la colección y consulta tu selección con Óptica Andina en Ecuador.">
  <section class="hero"><picture class="hero-media"><source media="(max-width: 760px)" srcset="/assets/hero-campaign-mobile.webp" /><img src="/assets/hero-campaign-desktop.webp" alt="Mujer con gafas de sol AXIA Solar Humo" width="1536" height="1024" fetchpriority="high" /></picture><div class="hero-content"><p class="eyebrow mint">AXIA EYEWEAR / ECUADOR</p><h1>El arte de<br /><span>mirar.</span></h1><p class="hero-sub">Siluetas con intención.<br />Objetos para ver y ser vistos.</p><a class="button" href={categoryUrl('gafas-de-sol')}>Explorar la colección <span>↗</span></a></div></section>
  <div class="intro-strip"><span>Diseño con carácter</span><i></i><span>Una mirada personal</span><i></i><span>Selección en Óptica Andina</span></div>
  <section class="container section-space"><div class="section-head"><div><p class="eyebrow">La selección / 2026</p><h2>Piezas para<br />tu mirada.</h2></div><a class="text-link" href="/colecciones/screen-glasses/">Ver todas las monturas ↗</a></div><div class="product-grid">{featured.map((product) => <ProductCard product={product} />)}</div></section>
  <section class="container section-space" style="padding-top:0"><div class="section-head"><div><p class="eyebrow">Explora AXIA</p><h2>Una forma.<br />Varias expresiones.</h2></div></div><div class="category-panels">{collections.map((item) => <a class="category-panel" href={categoryUrl(item.slug)}><ProductImage product={item.product} /><div><p>{item.number} / Colección</p><h3>{item.label}</h3><span>Descubrir ↗</span></div></a>)}</div></section>
  <section class="manifesto"><p class="eyebrow">ἀξία / AXIA</p><blockquote>Lo que tiene valor<br />propio permanece.</blockquote><p>AXIA toma su nombre de una idea antigua: el valor, el mérito y la dignidad de ser. Cada pieza acompaña una manera de mirar el mundo y de habitarlo.</p><a class="text-link" href="/axia/">Conoce la marca ↗</a></section>
</SiteLayout>
