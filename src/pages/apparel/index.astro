---
import SiteLayout from '../../layouts/SiteLayout.astro';
import apparel from '../../data/apparel.json';
import CampaignBanner from '../../components/CampaignBanner.astro';
import { campaigns } from '../../data/campaigns';

const groups = [
  { id: 't-shirts', label: 'T-Shirts', intro: 'El lenguaje de AXIA, llevado a lo cotidiano.' },
  { id: 'hoodies', label: 'Hoodies', intro: 'Capas cómodas con una identidad que permanece.' },
  { id: 'caps', label: 'Caps', intro: 'Un último detalle para completar la mirada.' },
];
type ApparelProduct = typeof apparel[number];
const image = (product: ApparelProduct, width = 640) => `/assets/apparel/${product.image}-${width}.webp`;
const wa = 'https://wa.me/593999028654?text=' + encodeURIComponent('Hola, vi la cápsula de apparel AXIA. Quiero compartir mi interés y recibir novedades.');
---
<SiteLayout title="Apparel · AXIA Objects" image="/assets/campaigns/apparel-desktop.webp" description="Explora seis conceptos de camisetas, hoodies y gorras AXIA. Diseños editoriales con precios objetivo referenciales, sujetos a producción y aprobación.">
  <CampaignBanner campaign={campaigns.apparel} title="Beyond the frame." intro="El lenguaje de AXIA, más allá de las gafas." href="#t-shirts" action="Ver conceptos" eyebrow="AXIA OBJECTS / A FIRST STUDY" />
  <div class="apparel-disclaimer"><span>Estudio de colección · No disponible para compra · Precios orientativos</span></div>
  <div class="container apparel-content">
    <nav class="apparel-nav" aria-label="Colecciones de Apparel">{groups.map(group => <a href={`#${group.id}`}>{group.label}</a>)}<span>6 conceptos</span></nav>
    {groups.map((group, groupIndex) => <section id={group.id} class="apparel-group" tabindex="-1"><header class="apparel-group-heading"><div><p class="eyebrow">0{groupIndex + 2} / AXIA OBJECTS</p><h2>{group.label}</h2></div><p>{group.intro}</p></header><div class="apparel-grid">{apparel.filter((item) => item.category === group.id).map((product, index) => <article class="apparel-item"><a class="apparel-item-image" href={`/apparel/${product.slug}/`} aria-label={`Ver concepto ${product.name}`}><picture><source srcset={`${image(product, 640).replace('.webp','.avif')}`} type="image/avif" /><img src={image(product)} alt={`Mockup conceptual ${product.name} AXIA, ${product.color}`} loading={groupIndex === 0 ? "eager" : "lazy"} width="640" height="853" /></picture><span>CONCEPT 0{groupIndex * 2 + index + 1}</span></a><div class="apparel-item-copy"><div><p class="product-kicker">{product.color}</p><h3><a href={`/apparel/${product.slug}/`}>{product.name}</a></h3></div><strong>~${product.estimatedPrice} USD*</strong></div><p class="apparel-hook">“{product.hook}”</p></article>)}</div></section>)}
    <div class="apparel-intro"><p class="eyebrow">THE AXIA EDIT / 01</p><h2>El valor propio<br /><em>se lleva a diario.</em></h2><p>Seis ideas iniciales que conectan el eyewear con prendas esenciales: carbón, blanco y un acento menta. Los renders muestran dirección visual; materiales, acabados, tallas y precio final requieren muestra y validación local.</p><a class="text-link" href={wa} target="_blank" rel="noopener noreferrer">Cuéntanos qué te gustaría usar ↗</a></div>
    <section class="apparel-production"><p class="eyebrow mint">FROM CONCEPT TO OBJECT</p><h2>Hecho para durar.<br /><em>Por definir con cuidado.</em></h2><p>Las prendas, tejidos y técnicas de impresión o bordado se elegirán después de cotizar y probar muestras con proveedores. Las fichas de cada concepto reúnen rutas posibles para reproducirlos.</p><a class="button button-outline" href={wa} target="_blank" rel="noopener noreferrer">Quiero recibir novedades ↗</a><small>*Valores de referencia inspirados en marcas internacionales de streetwear; no son precios de venta AXIA y pueden cambiar al validar costos en Ecuador.</small></section>
  </div>
</SiteLayout>

<style>
  .apparel-disclaimer{background:#f2f2f2;padding:10px 5%;font-size:10px;letter-spacing:.04em;line-height:1.4}
  .apparel-content{padding-bottom:90px}
  .apparel-nav{position:sticky;top:0;z-index:10;background:#fff;display:flex;align-items:center;gap:28px;border-bottom:1px solid var(--line)}
  .apparel-nav a{display:flex;align-items:center;min-height:50px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;border-bottom:2px solid transparent}
  .apparel-nav a:hover{border-color:#216f60;color:#216f60}
  .apparel-nav>span{margin-left:auto;font-size:11px;color:#625f59}
  .apparel-content:not(:has(.apparel-group:target)) .apparel-nav a:first-child,
  .apparel-content:has(#t-shirts:target) .apparel-nav a[href='#t-shirts'],
  .apparel-content:has(#hoodies:target) .apparel-nav a[href='#hoodies'],
  .apparel-content:has(#caps:target) .apparel-nav a[href='#caps']{border-color:#216f60;color:#216f60}
  .apparel-group{padding:20px 0 48px;scroll-margin-top:70px}
  .apparel-group-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:16px;border-bottom:1px solid var(--line);padding-bottom:12px}
  .apparel-group-heading h2{font:400 28px/1 'Manrope',sans-serif;letter-spacing:-.04em;margin:0}
  .apparel-group-heading .eyebrow{display:none}
  .apparel-group-heading>p{margin:0;color:var(--muted);font-size:12px;line-height:1.6}
  .apparel-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));max-width:860px;gap:30px 20px;margin:auto}
  .apparel-item-image{display:block;position:relative;background:#f5f5f3;overflow:hidden;aspect-ratio:1.7/1}
  .apparel-item-image picture,.apparel-item-image img{width:100%;height:100%;display:block}
  .apparel-item-image img{object-fit:contain;transition:transform .4s}
  .apparel-item-image:hover img,.apparel-item-image:focus-visible img{transform:scale(1.035)}
  .apparel-item-image>span{position:absolute;top:15px;left:15px;font-size:9px;letter-spacing:.16em;background:white;padding:9px}
  .apparel-item-copy{display:flex;justify-content:space-between;gap:15px;align-items:center;padding-top:16px}
  .apparel-item-copy h3{font:500 24px 'Manrope',sans-serif;letter-spacing:-.04em;margin:6px 0 0}
  .apparel-item-copy>strong{white-space:nowrap;font-size:13px}
  .apparel-hook{font:italic 17px 'Manrope',sans-serif;color:#64635f;margin:14px 0 0}
  .apparel-intro{max-width:900px;padding:45px 0 50px;border-top:1px solid var(--line)}
  .apparel-intro h2,.apparel-production h2{font:400 clamp(32px,4vw,54px)/1.05 'Manrope',sans-serif;letter-spacing:-.065em;margin:0 0 24px}
  .apparel-intro h2 em,.apparel-production h2 em{font-style:normal;color:#278878}
  .apparel-intro>p:not(.eyebrow),.apparel-production>p:not(.eyebrow){max-width:620px;color:#5f5d57;line-height:1.8;margin:0 0 30px}
  .apparel-production{margin:20px -5.5% 0;padding:75px 11%;background:#1f1f1f;color:#fff}
  .apparel-production h2 em{color:var(--mint)}
  .apparel-production>p:not(.eyebrow){color:#ccc}
  .apparel-production .button-outline{border-color:var(--mint);color:var(--mint)}
  .apparel-production small{display:block;color:#aaa;font-size:10px;line-height:1.6;margin-top:28px;max-width:750px}
  @media(max-width:760px){
    .apparel-disclaimer{padding:9px 5%;font-size:9px}
    .apparel-nav{gap:24px}.apparel-nav a{min-height:44px;font-size:10px}.apparel-nav>span{font-size:10px}
    .apparel-group{padding:14px 0 36px;scroll-margin-top:60px}.apparel-group-heading{margin-bottom:12px;padding-bottom:10px}
    .apparel-group-heading h2{font-size:24px}.apparel-group-heading>p{display:none}
    .apparel-grid{gap:26px 11px}.apparel-item-image{aspect-ratio:1.05/1}
    .apparel-item-image>span{top:8px;left:8px;font-size:8px}
    .apparel-item-copy{display:block;padding-top:12px}.apparel-item-copy h3{font-size:19px}
    .apparel-item-copy>strong{display:block;margin-top:9px;font-size:12px}
    .apparel-hook{font-size:13px;line-height:1.4}.apparel-intro{padding:30px 0 36px}
    .apparel-production{margin:5px -5.5% 0;padding:55px 7%}
  }
  @media(prefers-reduced-motion:reduce){.apparel-item-image img{transition:none;transform:none}}
</style>
