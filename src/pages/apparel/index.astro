---
import SiteLayout from '../../layouts/SiteLayout.astro';
import apparel from '../../data/apparel.json';

const groups = [
  { id: 't-shirts', label: 'T-Shirts', intro: 'El lenguaje de AXIA, llevado a lo cotidiano.' },
  { id: 'hoodies', label: 'Hoodies', intro: 'Capas cómodas con una identidad que permanece.' },
  { id: 'caps', label: 'Caps', intro: 'Un último detalle para completar la mirada.' },
];
type ApparelProduct = typeof apparel[number];
const image = (product: ApparelProduct, width = 640) => `/assets/apparel/${product.image}-${width}.webp`;
const wa = 'https://wa.me/593999028654?text=' + encodeURIComponent('Hola, vi la cápsula de apparel AXIA. Quiero compartir mi interés y recibir novedades.');
---
<SiteLayout title="Apparel · AXIA Objects" description="Explora seis conceptos de camisetas, hoodies y gorras AXIA. Diseños editoriales con precios objetivo referenciales, sujetos a producción y aprobación.">
  <section class="apparel-hero">
    <picture class="apparel-hero-image"><source srcset={image(apparel[2], 1100)} type="image/webp" /><img src={image(apparel[2], 1100)} alt="Concepto de hoodie AXIA carbón con gráfico lineal menta" fetchpriority="high" /></picture>
    <div class="apparel-hero-copy"><p class="eyebrow mint">AXIA OBJECTS / A FIRST STUDY</p><h1>Beyond<br />the frame.</h1><p>Una exploración de piezas para llevar la mirada AXIA más allá de las gafas.</p><a class="button" href="#t-shirts">Explorar conceptos <span>↓</span></a></div>
    <span class="apparel-hero-index">01 — 06 / CONCEPT STUDY</span>
  </section>
  <div class="apparel-disclaimer"><span>Estudio de colección · No disponible para compra</span><span>Precios objetivo estimados en USD, pendientes de cotización y aprobación.</span></div>
  <div class="container apparel-content">
    <div class="apparel-intro"><p class="eyebrow">THE AXIA EDIT / 01</p><h2>El valor propio<br /><em>se lleva a diario.</em></h2><p>Seis ideas iniciales que conectan el eyewear con prendas esenciales: carbón, blanco y un acento menta. Los renders muestran dirección visual; materiales, acabados, tallas y precio final requieren muestra y validación local.</p><a class="text-link" href={wa} target="_blank" rel="noopener noreferrer">Cuéntanos qué te gustaría usar ↗</a></div>
    {groups.map((group, groupIndex) => <section id={group.id} class="apparel-group"><header class="apparel-group-heading"><div><p class="eyebrow">0{groupIndex + 2} / AXIA OBJECTS</p><h2>{group.label}</h2></div><p>{group.intro}</p></header><div class="apparel-grid">{apparel.filter((item) => item.category === group.id).map((product, index) => <article class="apparel-item"><a class="apparel-item-image" href={`/apparel/${product.slug}/`} aria-label={`Ver concepto ${product.name}`}><picture><source srcset={`${image(product, 640).replace('.webp','.avif')}`} type="image/avif" /><img src={image(product)} alt={`Mockup conceptual ${product.name} AXIA, ${product.color}`} loading="lazy" /></picture><span>CONCEPT 0{groupIndex * 2 + index + 1}</span></a><div class="apparel-item-copy"><div><p class="product-kicker">{product.color}</p><h3><a href={`/apparel/${product.slug}/`}>{product.name}</a></h3></div><strong>~${product.estimatedPrice} USD*</strong></div><p class="apparel-hook">“{product.hook}”</p></article>)}</div></section>)}
    <section class="apparel-production"><p class="eyebrow mint">FROM CONCEPT TO OBJECT</p><h2>Hecho para durar.<br /><em>Por definir con cuidado.</em></h2><p>Las prendas, tejidos y técnicas de impresión o bordado se elegirán después de cotizar y probar muestras con proveedores. Las fichas de cada concepto reúnen rutas posibles para reproducirlos.</p><a class="button button-outline" href={wa} target="_blank" rel="noopener noreferrer">Quiero recibir novedades ↗</a><small>*Valores de referencia inspirados en marcas internacionales de streetwear; no son precios de venta AXIA y pueden cambiar al validar costos en Ecuador.</small></section>
  </div>
</SiteLayout>

<style>
  .apparel-hero{position:relative;min-height:min(720px,calc(100svh - 107px));background:#1f1f1f;color:white;overflow:hidden;display:flex;align-items:center;isolation:isolate}.apparel-hero::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#131313e8 0%,#131313a3 42%,transparent 78%);z-index:-1}.apparel-hero-image{position:absolute;inset:0;z-index:-2}.apparel-hero-image img{width:100%;height:100%;object-fit:cover;object-position:center 40%;opacity:.8}.apparel-hero-copy{padding:70px 9%;max-width:780px}.apparel-hero h1{font:500 clamp(72px,11vw,150px)/.85 'Manrope',sans-serif;letter-spacing:-.09em;margin:28px 0}.apparel-hero-copy>p:not(.eyebrow){max-width:430px;font-size:18px;line-height:1.6;color:#e4e4e4;margin:0 0 28px}.apparel-hero-index{position:absolute;right:5%;bottom:28px;font-size:9px;letter-spacing:.2em}.apparel-disclaimer{display:flex;justify-content:space-between;gap:20px;background:#f2f2f2;padding:17px 5%;font-size:10px;letter-spacing:.1em;text-transform:uppercase}.apparel-content{padding-bottom:90px}.apparel-intro{max-width:900px;padding:100px 0 90px}.apparel-intro h2,.apparel-production h2{font:400 clamp(46px,7vw,90px)/.99 'Manrope',sans-serif;letter-spacing:-.075em;margin:0 0 24px}.apparel-intro h2 em,.apparel-production h2 em{font-style:normal;color:#278878}.apparel-intro>p:not(.eyebrow),.apparel-production>p:not(.eyebrow){max-width:620px;color:#5f5d57;line-height:1.8;margin:0 0 30px}.apparel-group{padding:32px 0 92px;scroll-margin-top:24px}.apparel-group-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:30px;border-bottom:1px solid var(--line);padding-bottom:19px}.apparel-group-heading h2{font:400 clamp(42px,6vw,74px)/1 'Manrope',sans-serif;letter-spacing:-.07em;margin:0}.apparel-group-heading>p{max-width:290px;color:var(--muted);line-height:1.6;font-size:13px}.apparel-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:38px 20px}.apparel-item-image{display:block;position:relative;background:#f5f5f3;overflow:hidden;aspect-ratio:1.13/1}.apparel-item-image picture,.apparel-item-image img{width:100%;height:100%;display:block}.apparel-item-image img{object-fit:cover;transition:transform .55s}.apparel-item-image:hover img{transform:scale(1.035)}.apparel-item-image>span{position:absolute;top:15px;left:15px;font-size:9px;letter-spacing:.16em;background:white;padding:9px}.apparel-item-copy{display:flex;justify-content:space-between;gap:15px;align-items:center;padding-top:16px}.apparel-item-copy h3{font:500 24px 'Manrope',sans-serif;letter-spacing:-.04em;margin:6px 0 0}.apparel-item-copy>strong{white-space:nowrap;font-size:13px}.apparel-hook{font:italic 17px 'Manrope',sans-serif;color:#64635f;margin:14px 0 0}.apparel-production{margin:20px -5.5% 0;padding:95px 11%;background:#1f1f1f;color:#fff}.apparel-production h2 em{color:var(--mint)}.apparel-production>p:not(.eyebrow){color:#ccc}.apparel-production small{display:block;color:#aaa;font-size:10px;line-height:1.6;margin-top:28px;max-width:750px}
  @media(max-width:760px){.apparel-hero{min-height:max(600px,calc(100svh - 97px));align-items:end}.apparel-hero-image img{object-position:56% center}.apparel-hero::after{background:linear-gradient(0deg,#111e 0%,#1119 50%,#1112 100%)}.apparel-hero-copy{padding:0 7% 52px}.apparel-hero h1{font-size:clamp(63px,16vw,90px);margin:20px 0}.apparel-hero-copy>p:not(.eyebrow){font-size:16px;max-width:330px}.apparel-disclaimer{display:grid;gap:6px;padding:14px 6%;font-size:9px;line-height:1.5}.apparel-intro{padding:69px 0 45px}.apparel-group{padding:25px 0 65px}.apparel-group-heading{display:block}.apparel-group-heading h2{font-size:53px}.apparel-group-heading>p{margin-bottom:0}.apparel-grid{gap:30px 11px}.apparel-item-image{aspect-ratio:.86/1}.apparel-item-copy{display:block}.apparel-item-copy h3{font-size:19px}.apparel-item-copy>strong{display:block;margin-top:9px;font-size:12px}.apparel-hook{font-size:14px;line-height:1.4}.apparel-item-image>span{top:8px;left:8px;font-size:8px}.apparel-production{margin:5px -5.5% 0;padding:70px 7%}.apparel-production h2{font-size:48px}}
</style>
