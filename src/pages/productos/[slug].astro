---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductImage from '../../components/ProductImage.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, categories, categoryUrl, imageUrl, type Product } from '../../data/catalog';
export function getStaticPaths() { return products.map((product) => ({ params: { slug: product.slug }, props: { product } })); }
const { product } = Astro.props as { product: Product };
const related = products.filter((p) => p.category === product.category && p.slug !== product.slug).slice(0, 4);
const schema = { '@context':'https://schema.org', '@type':'Product', name:`AXIA ${product.title}`, description:product.description, image:Array.from({ length:product.imageCount }, (_,i) => new URL(imageUrl(product,i+1,1200,'webp'),'https://axiaeyewear.com').toString()), brand:{ '@type':'Brand', name:'AXIA Eyewear' }, category:categories[product.category].label, sku:product.code || undefined };
---
<SiteLayout title={`${product.title} · ${categories[product.category].label}`} description={`${product.description} Consulta precio y disponibilidad con Óptica Andina.`} image={imageUrl(product,1,1200,'webp')} schema={schema}>
  <div class="container"><div class="breadcrumbs"><a href="/">Inicio</a> / <a href={categoryUrl(product.category)}>{categories[product.category].label}</a> / {product.title}</div><div class="product-layout"><div><div class="gallery" role="region" aria-label={`Galería de AXIA ${product.title}`} tabindex="0">{Array.from({ length:product.imageCount }, (_,i) => <ProductImage product={product} index={i+1} large eager={i===0} />)}</div>{product.imageCount > 1 && <p class="gallery-hint">Desliza para ver más fotos →</p>}</div><div class="product-detail"><p class="category-label">AXIA / {categories[product.category].label}</p><h1>{product.title}</h1><p class="status">{product.status === 'sold_out' ? 'Agotado' : product.status === 'available' ? 'Disponible · consultar precio' : 'Consultar disponibilidad y precio'}</p><p class="lead">{product.description}</p><ul class="detail-list"><li><span>Tipo</span><strong>{product.type}</strong></li><li><span>Color observado</span><strong>{product.color}</strong></li><li><span>Código</span><strong>{product.code || 'Por confirmar'}</strong></li></ul><div class="product-actions">{product.status !== 'sold_out' && <button class="button button-dark" type="button" data-add-selection={product.slug}>Agregar a mi selección</button>}<button class="button button-outline" type="button" data-share>Compartir este modelo ↗</button></div><p class="small-copy">Tu selección se guarda en este navegador y se envía como consulta por WhatsApp. Precio, configuración final y disponibilidad se confirman con Óptica Andina.</p>{product.category === 'screen-glasses' && <p class="small-copy">Las lunas, tratamientos y filtros se consultan y cotizan por separado.</p>}{(product.category === 'clips' || product.type === 'Montura con clip solar') && <p class="small-copy">La configuración del clip se confirma directamente con Óptica Andina.</p>}</div></div>{related.length > 0 && <section class="section-space" style="padding-top:0"><div class="section-head"><div><p class="eyebrow">También puedes explorar</p><h2>Otras miradas.</h2></div></div><div class="product-grid">{related.map((p) => <ProductCard product={p} />)}</div></section>}</div>
</SiteLayout>
