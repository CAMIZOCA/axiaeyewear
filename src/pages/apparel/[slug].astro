---
import SiteLayout from '../../layouts/SiteLayout.astro';
import apparel from '../../data/apparel.json';
export function getStaticPaths() { return apparel.map((product) => ({ params: { slug: product.slug }, props: { product } })); }
const { product } = Astro.props;
const category = { 't-shirts': 'T-Shirts', hoodies: 'Hoodies', caps: 'Caps' }[product.category];
const image = `/assets/apparel/${product.image}`;
const wa = 'https://wa.me/593999028654?text=' + encodeURIComponent(`Hola, me interesa el concepto AXIA ${product.name}. Quisiera compartir mi opinión y conocer novedades.`);
---
<SiteLayout title={`${product.name} · Apparel Concept`} description={`${product.description} Concepto AXIA sin disponibilidad de compra; precio objetivo estimado sujeto a muestra y cotización.`} image={`${image}-1100.webp`}>
  <div class="container"><div class="breadcrumbs"><a href="/">Inicio</a> / <a href="/apparel/">Apparel</a> / {category} / {product.name}</div><div class="concept-layout"><div class="concept-image"><picture><source srcset={`${image}-1100.avif`} type="image/avif"/><img src={`${image}-1100.webp`} alt={`Mockup conceptual de ${product.name} AXIA, ${product.color}`} fetchpriority="high"/></picture><span>VISUAL CONCEPT · 01</span></div><section class="concept-detail"><p class="eyebrow">AXIA OBJECTS / {category}</p><p class="concept-status">Estudio de colección · No disponible para compra</p><h1>{product.name}</h1><p class="concept-hook">“{product.hook}”</p><p class="concept-description">{product.description}</p><div class="concept-estimate"><span>Precio objetivo estimado</span><strong>~${product.estimatedPrice} USD</strong><small>Referencial; sujeto a cotización, muestra y aprobación.</small></div><dl><div><dt>Color propuesto</dt><dd>{product.color}</dd></div><div><dt>Dirección gráfica</dt><dd>{product.design}</dd></div><div><dt>Ruta de producción</dt><dd>{product.production}</dd></div></dl><a class="button button-dark" href={wa} target="_blank" rel="noopener noreferrer">Me interesa este concepto ↗</a><p class="small-copy">Imagen generada como referencia visual. No representa una prenda fabricada ni confirma materiales, tallas o acabados.</p><a class="text-link" href="/apparel/">← Volver a AXIA Objects</a></section></div></div>
</SiteLayout>
<style>
 .concept-layout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(340px,.85fr);gap:clamp(36px,7vw,105px);padding:20px 0 100px;align-items:start}.concept-image{position:relative;background:#f5f5f3}.concept-image img{display:block;width:100%;height:auto}.concept-image>span{position:absolute;left:18px;top:18px;background:#fff;padding:9px 12px;font-size:9px;letter-spacing:.15em}.concept-detail{position:sticky;top:28px}.concept-status{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#278878;border-block:1px solid var(--line);padding:13px 0;margin:19px 0}.concept-detail h1{font:400 clamp(46px,5.2vw,76px)/.98 'Manrope',sans-serif;letter-spacing:-.07em;margin:0 0 22px}.concept-hook{font:italic 21px 'Manrope',sans-serif;color:#555;margin:0 0 15px}.concept-description{line-height:1.7;color:#5f5d57}.concept-estimate{display:grid;grid-template-columns:1fr auto;gap:5px 15px;border-block:1px solid var(--line);padding:18px 0;margin:23px 0}.concept-estimate span{font-size:12px;color:var(--muted)}.concept-estimate strong{font-size:15px}.concept-estimate small{grid-column:1/-1;color:var(--muted);font-size:10px}.concept-detail dl{margin:0 0 25px}.concept-detail dl div{border-bottom:1px solid var(--line);padding:13px 0}.concept-detail dt{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:6px}.concept-detail dd{margin:0;font-size:13px;line-height:1.6}.concept-detail>.button{width:100%}.concept-detail .small-copy{margin:13px 0 25px}
 @media(max-width:760px){.concept-layout{grid-template-columns:1fr;gap:30px;padding-top:4px;padding-bottom:65px}.concept-detail{position:static}.concept-detail h1{font-size:55px}.concept-image>span{top:10px;left:10px}.concept-hook{font-size:19px}}
</style>
