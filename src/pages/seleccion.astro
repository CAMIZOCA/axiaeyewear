---
import SiteLayout from '../layouts/SiteLayout.astro';
import { products } from '../data/catalog';
const selectionData = products.map((p) => ({ slug:p.slug, title:p.title, type:p.type, image:`/assets/catalog/${p.slug}/01-480.webp`, url:`/productos/${p.slug}/` }));
---
<SiteLayout title="Mi selección" description="Reúne tus modelos AXIA favoritos y consulta precio y disponibilidad con Óptica Andina por WhatsApp."><div class="container"><div class="breadcrumbs"><a href="/">Inicio</a> / Mi selección</div><header class="page-head"><p class="eyebrow">Modelos que te interesan</p><h1>Mi selección.</h1><p>Guarda los modelos que quieres conocer. Enviaremos una consulta por WhatsApp para confirmar precio y disponibilidad.</p></header><div class="selection-items" id="selection-items" aria-live="polite"></div><div class="selection-cta" id="selection-cta"></div></div><script define:vars={{ selectionData }}>
  const key='axia-selection-v1';
  const itemsEl=document.getElementById('selection-items');
  const ctaEl=document.getElementById('selection-cta');
  function read(){try{return JSON.parse(localStorage.getItem(key)||'[]')}catch{return []}}
  function render(){const selected=read();itemsEl.replaceChildren();ctaEl.replaceChildren();if(!selected.length){const empty=document.createElement('div');empty.className='selection-empty';empty.innerHTML='<p>Aún no has agregado modelos a tu selección.</p><a class="button button-dark" href="/colecciones/gafas-de-sol/">Explorar la colección ↗</a>';itemsEl.append(empty);return}for(const slug of selected){const item=selectionData.find(p=>p.slug===slug);if(!item)continue;const row=document.createElement('article');row.className='selection-item';const image=document.createElement('img');image.src=item.image;image.alt=`AXIA ${item.title}`;image.loading='lazy';const info=document.createElement('div');const title=document.createElement('h2');const link=document.createElement('a');link.href=item.url;link.textContent=item.title;title.append(link);const type=document.createElement('p');type.textContent=item.type;info.append(title,type);const remove=document.createElement('button');remove.type='button';remove.className='plain-button';remove.textContent='Quitar';remove.setAttribute('aria-label',`Quitar ${item.title}`);remove.onclick=()=>{localStorage.setItem(key,JSON.stringify(read().filter(x=>x!==slug)));document.dispatchEvent(new Event('axia:selection-changed'));render()};row.append(image,info,remove);itemsEl.append(row)}const names=selected.map(slug=>selectionData.find(p=>p.slug===slug)).filter(Boolean).map(p=>`• AXIA ${p.title}: https://axiaeyewear.com${p.url}`).join('\n');const text=`Hola, me interesan estos modelos AXIA y quisiera consultar precio y disponibilidad:\n${names}`;const a=document.createElement('a');a.className='button button-dark';a.href=`https://wa.me/593999028654?text=${encodeURIComponent(text)}`;a.target='_blank';a.rel='noopener noreferrer';a.textContent='Consultar por WhatsApp ↗';ctaEl.append(a);const note=document.createElement('p');note.className='small-copy';note.textContent='La consulta abrirá WhatsApp. No se realizará una compra ni un pago en esta web.';ctaEl.append(note)}
  document.addEventListener('axia:selection-changed',render);render();
</script></SiteLayout>
